\@writefile{lof}{\contentsline {figure}{\numberline {7.6}{\ignorespaces Top Panel: The $90\%$ credible regions for the mass-ratio distribution of the ${\sim }10 \,\,M_\odot $ peak (solid orange curves), ${\sim }35 \,\,M_\odot $ peak (dashed curves), and continuum (orange shaded region) components of the \textsc  {Extended Broken Power Law + 2 Peaks}\xspace  model. Bottom Panel: The $90\%$ credible regions for mass-ratio distribution of the ${\sim }10 \,\,M_\odot $ peak (solid blue curves) and the rest of the mass spectrum (blue shaded region) inferred with the \textsc  {Isolated Peak} model. The ${\sim }10\, \,M_\odot $ peak mass-ratio distribution from the \textsc  {Extended Broken Power Law + 2 Peaks}\xspace  is included for comparison.}}{334}{figure.caption.156}\protected@file@percent }
\newlabel{fig:mass_ratio_peak}{{7.6}{334}{Top Panel: The $90\%$ credible regions for the mass-ratio distribution of the ${\sim }10 \,\Msun $ peak (solid orange curves), ${\sim }35 \,\Msun $ peak (dashed curves), and continuum (orange shaded region) components of the \ExtendedBrokenPLTwoPeaks model. Bottom Panel: The $90\%$ credible regions for mass-ratio distribution of the ${\sim }10 \,\Msun $ peak (solid blue curves) and the rest of the mass spectrum (blue shaded region) inferred with the \textsc {Isolated Peak} model. The ${\sim }10\, \Msun $ peak mass-ratio distribution from the \ExtendedBrokenPLTwoPeaks is included for comparison}{figure.caption.156}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.7}{\ignorespaces Marginal spin magnitude $\chi $ (left) and cosine tilt angle $\cos \theta $ (right) distributions under the \textsc  {Gaussian Component Spins}\xspace  (blue) and \textsc  {B-Spline}\xspace  (green) models. The results from the \gwtc [3.0]\xspace  ~{\sc  Default} are shown for comparison (black dashed); note that this model is different from what is used for \gwtc [4.0]\xspace  . The \gwtc [3.0]\xspace  analysis employed a Beta distribution for spin magnitudes rather than a truncated normal, and fixed the location of the Gaussian component of the spin tilt angle distribution to $\cos \theta =1$ rather than letting it vary freely in inference. The solid lines show the median of the inferred distributions from \gwtc [4.0]\xspace  , and the shaded regions show their 90\% credible regions. The thick dashed lines show the median from \gwtc [3.0]\xspace  , while the thin dashed lines show its 90\% credible region.}}{335}{figure.caption.158}\protected@file@percent }
\newlabel{fig:spin_mag_tilt_pdf}{{7.7}{335}{Marginal spin magnitude $\chi $ (left) and cosine tilt angle $\cos \theta $ (right) distributions under the \default (blue) and \BSpline (green) models. The results from the \gwtcthree ~{\sc Default} are shown for comparison (black dashed); note that this model is different from what is used for \gwtcfour . The \gwtcthree analysis employed a Beta distribution for spin magnitudes rather than a truncated normal, and fixed the location of the Gaussian component of the spin tilt angle distribution to $\cos \theta =1$ rather than letting it vary freely in inference. The solid lines show the median of the inferred distributions from \gwtcfour , and the shaded regions show their 90\% credible regions. The thick dashed lines show the median from \gwtcthree , while the thin dashed lines show its 90\% credible region}{figure.caption.158}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.8}{\ignorespaces Larger ($\chi _A$, darker blue) and smaller ($\chi _B$, lighter blue) spin magnitude distributions, derived from imposing order statistics on the \textsc  {Gaussian Component Spins}\xspace  $\chi $ distribution shown in Figure~\ref {fig:spin_mag_tilt_pdf}. The solid lines show the median of each inferred distribution, and the shaded regions show the 90\% credible intervals.}}{336}{figure.caption.160}\protected@file@percent }
\newlabel{fig:spin_sorting_pdf}{{7.8}{336}{Larger ($\chi _A$, darker blue) and smaller ($\chi _B$, lighter blue) spin magnitude distributions, derived from imposing order statistics on the \default $\chi $ distribution shown in Figure~\ref {fig:spin_mag_tilt_pdf}. The solid lines show the median of each inferred distribution, and the shaded regions show the 90\% credible intervals}{figure.caption.160}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.9}{\ignorespaces Marginal $\chi _{\rm  eff}$ (left panel) and $\ensuremath  {\chi _\mathrm  {p}}$ (right panel) distributions. The solid lines show the median of each inferred distribution, and the shaded regions show the 90\% credible intervals. The \gwtc [4.0]\xspace  results under the \textsc  {Skew-normal Effective Spin}\xspace  model are shown in red; the \gwtc [3.0]\xspace  results under the \textsc  {Gaussian Effective Spins}\xspace  ~model are shown in purple dashed. The histogram inset in the left panel shows the skew parameter $\epsilon $ for the \textsc  {Skew-normal Effective Spin}\xspace  ~model. There is significant preference for a skewed $\chi _{\rm  eff}$ distribution, indicated by $\epsilon < 0$ with $\EpsSkewNormalChiEff [param][percent of epsilon less than zero]$\% credibility. }}{337}{figure.caption.164}\protected@file@percent }
\newlabel{fig:chi_eff_chi_p_pdf}{{7.9}{337}{Marginal $\chieff $ (left panel) and $\chip $ (right panel) distributions. The solid lines show the median of each inferred distribution, and the shaded regions show the 90\% credible intervals. The \gwtcfour results under the \skewnormalChiEff model are shown in red; the \gwtcthree results under the \effectiveSpinModel ~model are shown in purple dashed. The histogram inset in the left panel shows the skew parameter $\epsilon $ for the \skewnormalChiEff ~model. There is significant preference for a skewed $\chieff $ distribution, indicated by $\epsilon < 0$ with $\EpsSkewNormalChiEff [param][percent of epsilon less than zero]$\% credibility}{figure.caption.164}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.10}{\ignorespaces  Comparison of redshift models between \gwtc [3.0]\xspace  and \gwtc [4.0]\xspace  . \textit  {Top:} Posterior on the $\kappa $ parameter for the \textsc  {Power Law Redshift}\xspace  model. \gwtc [4.0]\xspace  shows increased support for positive values. \textit  {Bottom:} Median and 90\% credible regions for the comoving source frame rate in the \textsc  {Power Law Redshift}\xspace  model. We also show a comparison of the \textsc  {Power Law Redshift}\xspace  model and the weakly modeled\xspace  \textsc  {B-Spline}\xspace  model and a scaled cosmic star formation rate density \citep {Madau:2014bja}, which are consistent within uncertainties ($\kappa _{\rm  SFR} = 2.7$). }}{338}{figure.caption.166}\protected@file@percent }
\newlabel{fig:powerlaw_redshift_gwtc3_vs_gwtc4}{{7.10}{338}{Comparison of redshift models between \gwtcthree and \gwtcfour . \textit {Top:} Posterior on the $\kappa $ parameter for the \powerlawRedshift model. \gwtcfour shows increased support for positive values. \textit {Bottom:} Median and 90\% credible regions for the comoving source frame rate in the \powerlawRedshift model. We also show a comparison of the \powerlawRedshift model and the \nonparametricAdj \BSpline model and a scaled cosmic star formation rate density \citep {Madau:2014bja}, which are consistent within uncertainties ($\kappa _{\rm SFR} = 2.7$)}{figure.caption.166}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.11}{\ignorespaces  The inferred peak (top) and width (middle) of the $\chi _{\rm  eff}$ distribution as a function of mass ratio for the $(q,\chi _{\rm  eff})$~\textsc  {Linear}\xspace  ~model (blue) and \textsc  {Spline}\xspace  ~model (orange). The shaded regions in these panels give the 90\%~credible intervals. The bottom panel gives the posterior distribution for the gradient of the $\chi _{\rm  eff}$ distribution's peak ($\delta \mu _{\mathrm  {eff}|q}$) and natural log width ($\delta \ln \sigma _{\mathrm  {eff}|q}$) dependent on mass ratio. From dark to light, the shaded regions represent the 50\%, 90\% and 99\% credible intervals. Again, blue gives the result of the \textsc  {Linear}\xspace  ~model, while orange shows the result of the \textsc  {Spline}\xspace  ~model sliced through $q=0.6$ (the approximate point at which the gradients are largest). It appears that mass ratio and $\chi _{\rm  eff}$ exhibit some kind of correlation, but the exact nature is unclear. }}{339}{figure.caption.168}\protected@file@percent }
\newlabel{fig:q_chieff_mu_sigma}{{7.11}{339}{The inferred peak (top) and width (middle) of the $\chieff $ distribution as a function of mass ratio for the $(q,\chieff )$~\linearcorrelation ~model (blue) and \splinecorrelation ~model (orange). The shaded regions in these panels give the \confidenceLevel ~credible intervals. The bottom panel gives the posterior distribution for the gradient of the $\chieff $ distribution's peak ($\delta \mu _{\mathrm {eff}|q}$) and natural log width ($\delta \ln \sigma _{\mathrm {eff}|q}$) dependent on mass ratio. From dark to light, the shaded regions represent the 50\%, 90\% and 99\% credible intervals. Again, blue gives the result of the \linearcorrelation ~model, while orange shows the result of the \splinecorrelation ~model sliced through $q=0.6$ (the approximate point at which the gradients are largest). It appears that mass ratio and $\chieff $ exhibit some kind of correlation, but the exact nature is unclear}{figure.caption.168}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.12}{\ignorespaces  Mass ratio and $\chi _{\rm  eff}$ \acp {PPD} for the \textsc  {Copula}\xspace  ~model (blue) and \textsc  {Linear}\xspace  ~model (orange). The contours, from dark to light, mark 50\%, 90\%, and 99\% of the volume. We see a subtle preference for an anti-correlation, although this feature is far less prevalent than it appeared in \gwtc [3.0]\xspace  . We also see evidence for a broadening in the distribution as mass ratios become more unequal in the \textsc  {Linear}\xspace  ~model. The \textsc  {Copula}\xspace  ~model is not flexible in a way that it can capture a broadening. }}{340}{figure.caption.169}\protected@file@percent }
\acronymused{PPD}
\newlabel{fig:q_chieff_ppd}{{7.12}{340}{Mass ratio and $\chieff $ \acp {PPD} for the \copulacorrelation ~model (blue) and \linearcorrelation ~model (orange). The contours, from dark to light, mark 50\%, 90\%, and 99\% of the volume. We see a subtle preference for an anti-correlation, although this feature is far less prevalent than it appeared in \gwtcthree . We also see evidence for a broadening in the distribution as mass ratios become more unequal in the \linearcorrelation ~model. The \copulacorrelation ~model is not flexible in a way that it can capture a broadening}{figure.caption.169}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.13}{\ignorespaces  \textit  {Top:} inferred distributions of effective inspiral spin $\chi _{\rm  eff}$ in the correlated mass--spin \ac {BGP}~analysis. The solid lines give the median, while the shaded regions indicate the 90\%~credible intervals. In blue, we have the $\chi _{\rm  eff}$ distribution of \ac {BBH} systems with at least one mass inside the $30{-}40 \,\,M_\odot $ peak range. In orange, we have the $\chi _{\rm  eff}$ distribution of \ac {BBH} systems masses outside the $30{-}40 \,\,M_\odot $ peak range. While the two distributions are consistent within 90\%~credible intervals, systems outside the peak range appear to favour a distribution of $\chi _{\rm  eff}$ skewed toward more positive values. Meanwhile, systems inside the peak range appear to favour a more symmetrical distribution about $\chi _{\rm  eff}= 0$. \textit  {Middle:} inferred distributions of primary mass from the correlated mass--spin \ac {BGP}~analysis. \textit  {Bottom:} inferred distributions of secondary mass from the correlated mass--spin \ac {BGP}~analysis. In both mass plots, blue shows the distribution for systems with small spins, $\chi _{\rm  eff}$ in the range $(-0.05,0.05)$, while orange shows the distribution for systems with larger spins, $\chi _{\rm  eff}$ in the range $(0.1,0.2)$. Note the preference for a higher proportion of mergers with masses $\approx 30{-}40 \,\,M_\odot $ for low spin systems (blue). }}{341}{figure.caption.171}\protected@file@percent }
\acronymused{BGP}
\acronymused{BBH}
\acronymused{BBH}
\acronymused{BGP}
\acronymused{BGP}
\newlabel{fig:mass_spin_correlated_bgp_combined}{{7.13}{341}{\textit {Top:} inferred distributions of effective inspiral spin $\chieff $ in the correlated mass--spin \ac {BGP}~analysis. The solid lines give the median, while the shaded regions indicate the \confidenceLevel ~credible intervals. In blue, we have the $\chieff $ distribution of \ac {BBH} systems with at least one mass inside the $30{-}40 \,\Msun $ peak range. In orange, we have the $\chieff $ distribution of \ac {BBH} systems masses outside the $30{-}40 \,\Msun $ peak range. While the two distributions are consistent within \confidenceLevel ~credible intervals, systems outside the peak range appear to favour a distribution of $\chieff $ skewed toward more positive values. Meanwhile, systems inside the peak range appear to favour a more symmetrical distribution about $\chieff = 0$. \textit {Middle:} inferred distributions of primary mass from the correlated mass--spin \ac {BGP}~analysis. \textit {Bottom:} inferred distributions of secondary mass from the correlated mass--spin \ac {BGP}~analysis. In both mass plots, blue shows the distribution for systems with small spins, $\chieff $ in the range $(-0.05,0.05)$, while orange shows the distribution for systems with larger spins, $\chieff $ in the range $(0.1,0.2)$. Note the preference for a higher proportion of mergers with masses $\approx 30{-}40 \,\Msun $ for low spin systems (blue)}{figure.caption.171}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.14}{\ignorespaces  The inferred mean (top) and width (bottom) of the $\chi _{\rm  eff}$ distribution as a function of redshift for the \textsc  {Linear}\xspace  ~model (blue) and the \textsc  {Spline}\xspace  ~model (orange). The shaded regions give the 90\%~credible intervals. The gray dashed line indicates the redshift under which 90\% of the cumulative posterior probability lies across all events in \gwtc [4.0]\xspace  . Therefore, inferences above this redshift are dominated by the prior or population model. Note the logarithmic scale on the width (bottom panel). In either model, we find evidence that the width of the effective inspiral spin distribution increases with redshift up to $z \sim 1$. }}{342}{figure.caption.173}\protected@file@percent }
\newlabel{fig:z_chieff_mu_sigma}{{7.14}{342}{The inferred mean (top) and width (bottom) of the $\chieff $ distribution as a function of redshift for the \linearcorrelation ~model (blue) and the \splinecorrelation ~model (orange). The shaded regions give the \confidenceLevel ~credible intervals. The gray dashed line indicates the redshift under which 90\% of the cumulative posterior probability lies across all events in \gwtcfour . Therefore, inferences above this redshift are dominated by the prior or population model. Note the logarithmic scale on the width (bottom panel). In either model, we find evidence that the width of the effective inspiral spin distribution increases with redshift up to $z \sim 1$}{figure.caption.173}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.15}{\ignorespaces Inferred mass distributions of various strongly modeled approaches\xspace  compared to the fiducial mass model \textsc  {Broken Power Law + 2 Peaks}\xspace  (gray shaded) and the \textsc  {B-Spline}\xspace  model (black dashed). The fiducial model from \gwtc [3.0]\xspace  , \textsc  {Power Law + Peak}\xspace  , is shown in orange, a broken power law with a single peak in blue, and a broken power law with three peaks in pink.}}{343}{figure.caption.189}\protected@file@percent }
\newlabel{fig:mass_model_comp_1}{{7.15}{343}{Inferred mass distributions of various \parametrics compared to the fiducial mass model \BrokenPLTwoPeaks (gray shaded) and the \BSpline model (black dashed). The fiducial model from \gwtcthree , \PLPeak , is shown in orange, a broken power law with a single peak in blue, and a broken power law with three peaks in pink}{figure.caption.189}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.16}{\ignorespaces Differential merger rate as a function of primary mass (evaluated at $z=0.2$) of the two different modes recovered by the \textsc  {Broken Power Law + 2 Peaks}\xspace  model. The orange shaded region shows the 90\% credible interval for the dominant mode ($\BBHMassModelBayesFactors [default_dominant_mode]\%$ of posterior), reflecting a distinct peak at $35 \,\,M_\odot $, and the purple shaded region shows the $90\%$ credible interval for the subdominant mode ($\BBHMassModelBayesFactors [default_subdominant_mode] \%$ of posterior), reflecting a broken power law morphology without a distinct $35 \,\,M_\odot $ peak. The black dashed lines show the $90\%$ credible bounds of the \textsc  {Broken Power Law + 1 Peak} model for comparison. The inset figure shows the joint posterior of the peak mean $\mu _2$ and width $\sigma _2$ for each mode. The vertical grey shaded region indicates the $90\%$ credible interval of the sum $\mu _2 + \sigma _2$, which is consistent between both modes.}}{344}{figure.caption.190}\protected@file@percent }
\newlabel{fig:primary_mass_modes}{{7.16}{344}{Differential merger rate as a function of primary mass (evaluated at $z=0.2$) of the two different modes recovered by the \BrokenPLTwoPeaks model. The orange shaded region shows the 90\% credible interval for the dominant mode ($\BBHMassModelBayesFactors [default_dominant_mode]\%$ of posterior), reflecting a distinct peak at $35 \,\Msun $, and the purple shaded region shows the $90\%$ credible interval for the subdominant mode ($\BBHMassModelBayesFactors [default_subdominant_mode] \%$ of posterior), reflecting a broken power law morphology without a distinct $35 \,\Msun $ peak. The black dashed lines show the $90\%$ credible bounds of the \textsc {Broken Power Law + 1 Peak} model for comparison. The inset figure shows the joint posterior of the peak mean $\mu _2$ and width $\sigma _2$ for each mode. The vertical grey shaded region indicates the $90\%$ credible interval of the sum $\mu _2 + \sigma _2$, which is consistent between both modes}{figure.caption.190}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.17}{\ignorespaces Distribution of \textsc  {Gaussian Component Spins}\xspace  ~hyperparameters for the primary \ac {BH} (blue) and secondary \ac {BH} (red) when neither magnitudes nor tilts are assumed identical (last row of Table~\ref {tab:modelComparisonSpins}), compared to when they are both assumed identical (gray, first row of Table~\ref {tab:modelComparisonSpins}). The contours of the two dimensional distributions mark the 50th and 90th percentiles.}}{345}{figure.caption.192}\protected@file@percent }
\acronymused{BH}
